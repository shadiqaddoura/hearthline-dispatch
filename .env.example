# Copy to .env. Matches docker-compose.yml.
DATABASE_URL="postgresql://hearthline:hearthline@localhost:5433/hearthline"
# Used by `npm test`. The test suite truncates every table in this database.
TEST_DATABASE_URL="postgresql://hearthline:hearthline@localhost:5433/hearthline_test"

# Exact public origin. Required in production; use HTTPS there.
AUTH_ORIGIN="http://localhost:3000"
# One-time provisioning only. Supply distinct secrets (15+ characters, <=1024 bytes)
# through the process environment or a local ignored .env; never commit real values.
AUTH_ADMIN_EMAIL=""
AUTH_ADMIN_NAME="Admin"
AUTH_ADMIN_PASSWORD=""
AUTH_OPERATIONS_EMAIL=""
AUTH_OPERATIONS_NAME="Operations"
AUTH_OPERATIONS_PASSWORD=""
