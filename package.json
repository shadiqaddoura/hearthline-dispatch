{
  "name": "hearthline-webapp-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "import:book": "tsx --conditions=react-server scripts/import-book.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "26.1.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@fluentui/react-tabster": {
      "keyborg": "3.498.0"
    }
  }
}
